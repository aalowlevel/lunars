// Dict with methods
person = {
    name: "Alice",
    age: 30,
    fn greet() {
        print("Hello, my name is", self.name)
    }
}

// Call method
person.greet()  // Output: Hello, my name is Alice

// Lists
list = [1, 2, "three"]
print("list =", list)

// Dicts
dict = { name: "Alice", age: 30 }
print("dict =", dict)

// Access elements
print("list[0] =", list[0])
print("dict['name'] =", dict["name"])