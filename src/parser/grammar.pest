WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* }

// Identifiers and literals
ident   = @{ !(keyword | keyword_reserved) ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
number  = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
string  =  { "\"" ~ ("\\\"" | !"\"" ~ ANY)* ~ "\"" }
boolean =  { "true" | "false" }
null    =  { "null" }

// Keywords - keeping minimal set for simplicity
keyword = @{
    "fn"
  | "if"
  | "else"
  | "while"
  | "for"
  | "loop"
  | "true"
  | "false"
  | "null"
  | "use"
  | "return"
  | "break"
  | "continue"
  | "pub"
  | "extern"
  | "match"
  | "self"
  | "mod" // Added mod keyword for module support
}

// Reserved keywords (for future use)
keyword_reserved = @{
    "super"
  | "let"
  | "type"
  | "trait"
  | "impl"
  | "async"
  | "await"
}

// Expression structure using Pratt parsing approach
expr    =  { term ~ (infix_op ~ term)* }
term    =  { primary ~ postfix* }
primary = _{
    prefix_op* ~ (number | string | boolean | null | list | dict | func_call | "self" | ident | "(" ~ expr ~ ")")
}

// Postfix operations for properties and method calls
postfix        = _{ prop_or_method }
prop_or_method =  {
    "." ~ ident ~ ("(" ~ args? ~ ")")?
}
args           =  { expr ~ ("," ~ expr)* }

// Operators
infix_op  = _{ add_op | mul_op | cmp_op | eq_op | log_op }
add_op    =  { "+" | "-" }
mul_op    =  { "*" | "/" | "%" }
cmp_op    =  { ">" | "<" | ">=" | "<=" }
eq_op     =  { "==" | "!=" }
log_op    =  { "&&" | "||" }
prefix_op =  { "-" | "!" }

// Assignment
assign = { lvalue ~ "=" ~ expr }
lvalue = { (ident | "self") ~ ("." ~ ident)* }

// Function calls
func_call = { ident ~ "(" ~ args? ~ ")" }

// Data structures
list = { "[" ~ (expr ~ ("," ~ expr)*)? ~ "]" }
dict = {
    "{" ~ (dict_entry ~ ("," ~ dict_entry)* ~ ","?)? ~ "}"
}

// Dict entries
dict_entry  = _{ dict_pair | dict_method }
dict_pair   =  { (ident | string | "[" ~ expr ~ "]") ~ ":" ~ expr }
dict_method =  { "fn" ~ ident ~ "(" ~ param_list? ~ ")" ~ block }

// Visibility for exports
visibility = { "pub" }

// Module definition (new) with optional pub visibility
module_def  =  { visibility? ~ "mod" ~ ident ~ "{" ~ module_item* ~ "}" }
module_item = _{
    func_def
  | extern_block
  | module_def // Allow nested modules
}

// External functions
extern_block   = { "extern" ~ "{" ~ extern_fn_decl* ~ "}" }
extern_fn_decl = { visibility? ~ "fn" ~ ident ~ "(" ~ param_list? ~ ")" }

// Parameters
param_list = { param ~ ("," ~ param)* }
param      = { ident }

// Statements
stmt    = {
    assign
  | expr
  | if_stmt
  | while_loop
  | for_loop
  | loop_stmt
  | func_def
  | extern_block
  | return_stmt
  | break_stmt
  | continue_stmt
  | use_stmt
  | match_stmt
  | module_def // Added module definition
}
program = { SOI ~ stmt* ~ EOI }

// Control flow
if_stmt      = { "if" ~ expr ~ block ~ (else_if_stmt)* ~ ("else" ~ block)? }
else_if_stmt = { "else" ~ "if" ~ expr ~ block }
block        = { "{" ~ stmt* ~ "}" }

while_loop = { "while" ~ expr ~ block }
for_loop   = { "for" ~ ident ~ "in" ~ expr ~ block }
loop_stmt  = { "loop" ~ block }

// Function control
return_stmt   = { "return" ~ expr? }
break_stmt    = { "break" }
continue_stmt = { "continue" }

// Functions
func_def = { visibility? ~ "fn" ~ ident ~ "(" ~ param_list? ~ ")" ~ block }

// Modules
use_stmt    = { "use" ~ module_path }
module_path = { ident ~ ("::" ~ ident)* ~ ("::" ~ "{" ~ ident ~ ("," ~ ident)* ~ "}")? }

// Pattern matching
match_stmt = { "match" ~ expr ~ "{" ~ match_arm* ~ "}" }
match_arm  = { pattern ~ "=>" ~ (block | expr) ~ ","? }
pattern    = {
    "_"
  | ident
  | number
  | string
  | boolean
  | null
  | list_pattern
  | dict_pattern
}

list_pattern      = {
    "[" ~ ((pattern ~ ("," ~ pattern)* ~ ("," ~ ".." ~ ident?)?) | (".." ~ ident?))? ~ "]"
}
dict_pattern      = { "{" ~ (dict_pair_pattern ~ ("," ~ dict_pair_pattern)*)? ~ "}" }
dict_pair_pattern = { (ident | string | "[" ~ expr ~ "]") ~ ":" ~ pattern }
